# Project parameters

# Golang module name
GOMODULE = github.com/m-sign/tools

# List of directories with binaries code
BINARIES = \
	./cmd/msign \

# Release builds: <GOOS>-<GOARCH>. The asset names bin/msign-<GOOS>-<GOARCH>[.exe]
# must not change: deployed v0.1.x self-update clients look for them.
BUILDS = \
	darwin-amd64  \
	darwin-arm64  \
	linux-amd64   \
	linux-arm64   \
	windows-amd64 \
	windows-arm64 \

# Public key that release signatures must verify with. The private key comes
# from the MSIGN_PRIVATE environment variable.
RELEASE_PUB ?= keys/release.pub
